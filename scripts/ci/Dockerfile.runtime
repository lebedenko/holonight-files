# Reuse the exact Qt runtime used to build providers (their private Qt ABI matters).
ARG FILES_CI_IMAGE=ghcr.io/lebedenko/holonight-shell-ci@sha256:4a1a177988c441c523bd31952a58953343ac8e6f031c7563e5b1e90ffb7d8bd6
FROM ${FILES_CI_IMAGE}
# Apply the same checksum-verified supplements as the build container, offline.
COPY packages/ /ci/packages/
COPY packages.json install-runtime-tools.py /ci/
RUN python3 /ci/install-runtime-tools.py
COPY --chown=root:root payload/usr/ /usr/
COPY check/ /opt/check/
RUN useradd -m files-test \
    && update-desktop-database /usr/share/applications && ldconfig \
    && install -d -o files-test -g files-test -m 0700 /home/files-test /run/files-test
ENV HOME=/home/files-test XDG_RUNTIME_DIR=/run/files-test \
    QT_QPA_PLATFORM=offscreen QSG_RHI_BACKEND=software
USER files-test
WORKDIR /opt/check
CMD ["bash", "scripts/isolated-runtime.sh"]
