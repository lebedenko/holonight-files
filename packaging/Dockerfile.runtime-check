# Installed payload atop the same immutable qualified environment; no acquisition.
ARG FILES_CI_IMAGE=ghcr.io/lebedenko/holonight-deps@sha256:37ca051c39d1688d6413c47d94b8c0f221152dac6981ec67d155f2c43ea17b40
FROM ${FILES_CI_IMAGE}
COPY --chown=root:root payload/usr/ /usr/
COPY check/ /opt/check/
RUN useradd -m files-test \
    && update-desktop-database /usr/share/applications && ldconfig \
    && install -d -o files-test -g files-test -m 0700 /home/files-test /run/files-test
ENV HOME=/home/files-test XDG_RUNTIME_DIR=/run/files-test \
    QT_QPA_PLATFORM=offscreen QSG_RHI_BACKEND=software
USER files-test
WORKDIR /opt/check
CMD ["bash", "scripts/isolated-runtime.sh"]
