{
  "module": "holonight-files",
  "cpp": true,
  "qml": true,
  "languages": [
    "cpp",
    "qml",
    "python",
    "bash"
  ],
  "dependencies": [
    {
      "module": "holonight-config",
      "package": "HoloNightConfig",
      "source_variable": "HOLONIGHT_CONFIG_SOURCE"
    },
    {
      "module": "holonight-system-services",
      "package": "HoloNightSystemServices",
      "source_variable": "HOLONIGHT_SYSTEM_SERVICES_SOURCE",
      "options": [
        "-DBUILD_AUDIO=OFF",
        "-DBUILD_STORAGE=ON"
      ]
    },
    {
      "module": "holonight-qt",
      "package": "HolonightQt",
      "source_variable": "HOLONIGHT_QT_SOURCE"
    },
    {
      "module": "holonight-images",
      "package": "HolonightImages",
      "source_variable": "HOLONIGHT_IMAGES_SOURCE"
    },
    {
      "module": "holonight-thumbnails",
      "package": "HolonightThumbnails",
      "source_variable": "HOLONIGHT_THUMBNAILS_SOURCE"
    },
    {
      "module": "holonight-search",
      "package": "HolonightSearch",
      "source_variable": "HOLONIGHT_SEARCH_SOURCE"
    }
  ],
  "qml_modules": [
    "HolonightFiles",
    "Holonight.FileBrowser"
  ],
  "wayland": false,
  "external_dependencies": [
    {
      "id": "qt",
      "scope": [
        "build"
      ],
      "components": [
        "Core"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "build"
      ],
      "components": [
        "Gui",
        "Quick",
        "Qml",
        "QuickControls2",
        "Svg"
      ],
      "feature": "BUILD_FILES_APP"
    },
    {
      "id": "toml",
      "scope": [
        "build"
      ],
      "version": "3.4",
      "feature": "BUILD_FILES_APP"
    },
    {
      "id": "qmarkdown",
      "scope": [
        "build"
      ],
      "feature": "BUILD_FILES_APP",
      "version": "1.1"
    },
    {
      "id": "exif",
      "scope": [
        "test"
      ]
    },
    {
      "id": "compiler",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "cmake",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "ninja",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "pkgconf",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "git",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "python",
      "scope": [
        "tool"
      ]
    },
    {
      "id": "gtest",
      "scope": [
        "test"
      ],
      "targets": [
        "GTest::gtest"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "test"
      ],
      "components": [
        "Test"
      ]
    },
    {
      "id": "fonts",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "mime",
      "scope": [
        "runtime"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "test"
      ],
      "components": [
        "OpenGL"
      ]
    },
    {
      "id": "qt",
      "scope": [
        "build"
      ],
      "components": [
        "Gui",
        "Quick",
        "Qml",
        "QuickControls2"
      ],
      "feature": "BUILD_FILE_BROWSER_QUICK"
    }
  ],
  "external_features": {
    "BUILD_FILES_APP": true,
    "BUILD_FILE_BROWSER_QUICK": true
  },
  "external_sources": [
    {
      "module": "qmarkdown",
      "package": "QMarkdown",
      "source_variable": "QMARKDOWN_SOURCE",
      "options": [
        "-DBUILD_SHARED_LIBS=ON",
        "-DQMARKDOWN_BUILD_EXAMPLES=OFF",
        "-DQMARKDOWN_BUILD_BENCHMARKS=OFF"
      ]
    }
  ]
}
