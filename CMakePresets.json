{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib"
      },
      "environment": {
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml",
        "LD_LIBRARY_PATH": "${sourceDir}/build/deps/prefix/lib"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib"
      },
      "environment": {
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml",
        "LD_LIBRARY_PATH": "${sourceDir}/build/deps/prefix/lib"
      }
    },
    {
      "name": "test",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/test",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib"
      },
      "environment": {
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml",
        "LD_LIBRARY_PATH": "${sourceDir}/build/deps/prefix/lib"
      }
    },
    {
      "name": "system-install",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/system-install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_PREFIX_PATH": "/usr",
        "HOLONIGHT_DEPENDENCY_PREFIX": "/usr",
        "HOLONIGHT_QML_IMPORT_PATH": "/usr/lib/qt6/qml",
        "HolonightQt_DIR": "/usr/lib/cmake/HolonightQt"
      },
      "environment": {
        "QML_IMPORT_PATH": "/usr/lib/qt6/qml",
        "QML2_IMPORT_PATH": "/usr/lib/qt6/qml",
        "LD_LIBRARY_PATH": "/usr/lib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "test",
      "configurePreset": "test"
    },
    {
      "name": "system-install",
      "configurePreset": "system-install"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
